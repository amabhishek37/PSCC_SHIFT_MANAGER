function switchTab(name){
  ["sched","results","log","rules"].forEach(function(t){
    document.getElementById("ctab-"+t).classList.remove("act");
    document.getElementById("cpanel-"+t).classList.remove("act");
  });
  document.getElementById("ctab-"+name).classList.add("act");
  document.getElementById("cpanel-"+name).classList.add("act");
}

function toggleEditMode() {
    isEditMode = !isEditMode;
    var btn = document.getElementById("editToggleBtn");
    if (isEditMode) {
        btn.innerHTML = "🟢 Edit Mode: ON";
        btn.style.background = "var(--s1)";
        btn.style.borderColor = "var(--gr)";
        btn.style.color = "var(--gr)";
    } else {
        btn.innerHTML = "✏️ Enable Edit Mode";
        btn.style.background = "";
        btn.style.borderColor = "";
        btn.style.color = "";
    }
}

function handleCellClick(person, dayIdx, dateLabel) {
    if (isEditMode) {
        editTargetPerson = person;
        editTargetDay = dayIdx;
        var cur = RAW_SCHEDULE[person][dayIdx];
        document.getElementById("editInput").value = cur || "";
        document.getElementById("editTitle").innerText = "Edit " + person + " (" + dateLabel + ")";
        document.getElementById("editModal").style.display = "flex";
        document.getElementById("editInput").focus();
    } else {
        if (person === document.getElementById("selName").value) {
            document.getElementById('selDate').value = D[dayIdx].label;
            var myShift = RAW_SCHEDULE[person][dayIdx];
            var selType = document.getElementById("selType");
            
            if (!myShift) {
                selType.value = "off_work";
            } else {
                if (selType.value === "off_work") {
                    selType.value = "shift"; 
                }
            }
            onDateChange();
        }
    }
}

function saveEdit() {
    var val = document.getElementById("editInput").value.trim().toUpperCase();
    if (val === "OFF" || val === "L" || val === "") val = null;
    
    var oldVal = RAW_SCHEDULE[editTargetPerson][editTargetDay] || "OFF";
    var newVal = val || "OFF";

    if (oldVal !== newVal) {
        RAW_SCHEDULE[editTargetPerson][editTargetDay] = val;
        var now = new Date();
        var tsString = now.toLocaleDateString() + " " + now.toLocaleTimeString();
        
        CHANGE_LOG.unshift({
            ts: tsString,
            type: 'single',
            person: editTargetPerson,
            date: D[editTargetDay].label,
            oldS: oldVal,
            newS: newVal
        });
        renderLog();
        updateMutualSwapOperators();
    }

    document.getElementById("editModal").style.display = "none";
    
    onNameChange();
    if (document.getElementById('selDate').value) {
        findOptions();
    }
}

function closeEdit() {
    document.getElementById("editModal").style.display = "none";
}

function populateSwapForm() {
    var d1 = document.getElementById("msD1"), d2 = document.getElementById("msD2");
    d1.innerHTML = "<option value='-1'>-- Date 1 --</option>";
    d2.innerHTML = "<option value='-1'>-- Date 2 (Optional) --</option>";
    
    for(var i=1; i<D.length; i++){
        d1.add(new Option(D[i].label, i));
        d2.add(new Option(D[i].label, i));
    }
    updateMutualSwapOperators();
}

function updateMutualSwapOperators() {
    var p1 = document.getElementById("msP1");
    var p2 = document.getElementById("msP2");
    var d1 = parseInt(document.getElementById("msD1").value);
    
    var val1 = p1.value;
    var val2 = p2.value;

    p1.innerHTML = ""; p2.innerHTML = "";
    
    N.forEach(function(n) {
        var shiftTxt = "";
        if (d1 > 0 && !isNaN(d1)) {
            var s = RAW_SCHEDULE[n][d1] || "OFF";
            shiftTxt = " (" + s + ")";
        }
        p1.add(new Option(n + shiftTxt, n));
        p2.add(new Option(n + shiftTxt, n));
    });

    if (val1) p1.value = val1;
    if (val2) p2.value = val2;
    if (!p2.value && N.length > 1) p2.selectedIndex = 1;
}

function applyMutualSwap() {
    var p1 = document.getElementById("msP1").value;
    var p2 = document.getElementById("msP2").value;
    var d1 = parseInt(document.getElementById("msD1").value);
    var d2 = parseInt(document.getElementById("msD2").value);

    if (!p1 || !p2 || p1 === p2) { alert("Select two different operators."); return; }
    if (d1 < 1 || isNaN(d1)) { alert("Select at least Date 1."); return; }

    var d1Label = D[d1].label;
    var p1OldD1 = RAW_SCHEDULE[p1][d1] || "OFF";
    var p2OldD1 = RAW_SCHEDULE[p2][d1] || "OFF";

    RAW_SCHEDULE[p1][d1] = (p2OldD1 === "OFF") ? null : p2OldD1;
    RAW_SCHEDULE[p2][d1] = (p1OldD1 === "OFF") ? null : p1OldD1;

    var msg = `<b>${p1}</b> and <b>${p2}</b> swapped on <b>${d1Label}</b> (${bdg(p1OldD1)} &harr; ${bdg(p2OldD1)})`;

    if (d2 > 0 && d2 !== d1) {
        var d2Label = D[d2].label;
        var p1OldD2 = RAW_SCHEDULE[p1][d2] || "OFF";
        var p2OldD2 = RAW_SCHEDULE[p2][d2] || "OFF";
        
        RAW_SCHEDULE[p1][d2] = (p2OldD2 === "OFF") ? null : p2OldD2;
        RAW_SCHEDULE[p2][d2] = (p1OldD2 === "OFF") ? null : p1OldD2;
        
        msg += `<br>and on <b>${d2Label}</b> (${bdg(p1OldD2)} &harr; ${bdg(p2OldD2)})`;
    }

    var now = new Date();
    CHANGE_LOG.unshift({
        ts: now.toLocaleDateString() + " " + now.toLocaleTimeString(),
        type: 'mutual',
        msg: msg
    });

    renderLog();
    updateMutualSwapOperators();
    onNameChange(); 
    if(document.getElementById('selDate').value) findOptions();
    
    alert("Mutual swap successfully applied and logged!");
    switchTab('log');
}

function renderLog() {
    var h = "<div class='sec-hdr'>Recent Session Changes <span class='cnt g'>" + CHANGE_LOG.length + "</span></div>";
    if (CHANGE_LOG.length === 0) {
        h += "<div class='empty'>No manual changes made yet. Enable Edit Mode or log a mutual exchange to track updates.</div>";
    } else {
        h += "<table class='gtable'><tr><th style='width:120px'>Timestamp</th><th>Modification</th></tr>";
        CHANGE_LOG.forEach(function(log) {
            h += "<tr>";
            h += "<td style='color:var(--mt);font-size:10px;vertical-align:top'>" + log.ts + "</td>";
            if (log.type === 'mutual') {
                h += "<td style='line-height:1.6'>" + log.msg + "</td>";
            } else {
                h += "<td><b style='color:var(--txt)'>" + log.person + "</b> on <b style='color:var(--gr)'>" + log.date + "</b>: " + bdg(log.oldS) + " <span style='color:var(--mt)'>&rarr;</span> " + bdg(log.newS) + "</td>";
            }
            h += "</tr>";
        });
        h += "</table>";
