}

function exportExcel() {
  var aoa = [];
  var headerDates = [null, null];
  var headerDays = [null, "NAME"];
  
  for (var i = 1; i < D.length; i++) {
    headerDates.push(D[i].label);
    headerDays.push(D[i].day);
  }
  aoa.push(headerDates);
  aoa.push(headerDays);
  
  N.forEach(function(person) {
    var row = [null, person];
    for (var i = 1; i < D.length; i++) {
      row.push(RAW_SCHEDULE[person][i] || ""); 
