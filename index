var E1=new Set(), EA=new Set(), BAPM=new Set(), BSC=new Set(), BG=new Set();
var FEM=new Set(["ANANYA","SWATIREKHA","MANEESHA","MADHULIKA","PRAVATI","MANORANJAN","PRAGNYA"]);

