    aoa.push(row);
  });
  
  var ws = XLSX.utils.aoa_to_sheet(aoa);
  var wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, "Table 1");
  XLSX.writeFile(wb, "PSCC_Updated_Schedule.xlsx");
}

function findOptions(){
  var me = document.getElementById("selName").value;
  var dl = document.getElementById("selDate").value;
  var type = document.getElementById("selType").value;
  var desired = document.getElementById("selDesired").value || null;
  if(!me){ alert("Select your name."); return; }
  if(!dl){ alert("Select a date."); return; }
  
  var dayIdx = D.findIndex(function(d) { return d.label === dl; });
  if (dayIdx < 0) return;

  switchTab("results");
  var r;
  if(type==="shift"){
    r = doShift(me, dayIdx, desired);
  } else if(type==="off_want"){
    r = doOffWant(me, dayIdx, desired);
  } else {
    r = doOffWork(me, dayIdx, desired);
  }

  if(r.error){ 
      document.getElementById('resultsOut').innerHTML = "<div class=\"wbox\">"+r.error+"</div>"; 
      return; 
  }
  renderResults(me, dayIdx, r, type);
}

function renderSched(me){
  var aC=0, bC=0, cC=0, oC=0, i, d, sh, isOff, l, desk, cls, h;
  for(i=1; i<D.length; i++){
    sh = RAW_SCHEDULE[me][i];
    if(!sh){oC++;continue;}
    if(sh.charAt(0)==="A") aC++; else if(sh.charAt(0)==="B") bC++; else if(sh.charAt(0)==="C") cC++;
  }
  h  = "<div class=\"stats\">";
  h += "<div class=\"stat-card\"><div class=\"stat-val\" style=\"color:var(--gr)\">"+aC+"</div><div class=\"stat-lbl\">A-Shifts</div></div>";
  h += "<div class=\"stat-card\"><div class=\"stat-val\">"+bC+"</div><div class=\"stat-lbl\">B-Shifts</div></div>";
  h += "<div class=\"stat-card\"><div class=\"stat-val\" style=\"color:var(--or)\">"+cC+"</div><div class=\"stat-lbl\">C-Shifts</div></div>";
  h += "<div class=\"stat-card\"><div class=\"stat-val\" style=\"color:var(--gr)\">"+oC+"</div><div class=\"stat-lbl\">Offs</div></div>";
  h += "</div>";
  h += "<p style=\"font-size:11px;color:var(--mt);margin-bottom:10px\">Click any day card to instantly find swap options</p>";
  h += "<div class=\"sgrid\">";
  for(i=1; i<D.length; i++){
    d = D[i]; sh = RAW_SCHEDULE[me][i]; isOff = !sh; l = sh ? sh.charAt(0) : ""; desk = sh ? sh.slice(1) : "";
    cls = "day-card" + (isOff ? " off" : "") + (l ? " s"+l : "");
    h += "<div class=\""+cls+"\" onclick=\"handleCellClick('" + me + "', " + i + ", '" + d.label + "')\">";
    h += "<div class=\"dc-date\">"+d.label+"</div>";
    h += "<div class=\"dc-day\">"+d.day+"</div>";
    h += "<div class=\"dc-sh\">"+(isOff?"OFF":l)+"</div>";
    if(!isOff) h += "<div class=\"dc-desk\">"+desk+"</div>";
    h += "</div>";
  }
  h += "</div>";
  document.getElementById("schedOut").innerHTML = h;
}

function onDateChange() {
  findOptions();
}

function onNameChange(){
  var me = document.getElementById("selName").value;
  renderSched(me); 
  
  var sel = document.getElementById("selDate"), i, d, sh, o;
  sel.innerHTML = "<option value=\"\">-- Pick a date --</option>";
  for(i=1; i<D.length; i++){
    d = D[i]; sh = RAW_SCHEDULE[me][i] || "OFF";
    o = document.createElement("option");
    o.value = d.label; o.text = d.label+" ("+d.day+") - "+sh;
    sel.appendChild(o);
  }
  
  var el = document.getElementById("sidebarInfo");
  var offs=[], working=0;
  for(i=1; i<D.length; i++){ 
      var ts = RAW_SCHEDULE[me][i]; 
      if(!ts) offs.push(D[i].label); else working++; 
  }
  el.innerHTML = "<b>"+me+"</b><br>" +
    "Working: <span style=\"color:var(--ac)\">"+working+" days</span><br>" +
    "Off days: <span style=\"color:var(--gr)\">"+offs.length+"</span><br>" +
    (EA.has(me) ? "<span style=\"color:var(--pu)\">&#10003; 33kV Eligible</span><br>" : "") +
    (E1.has(me) ? "<span style=\"color:var(--yw)\">&#10003; Desk-1 Certified</span><br>" : "");
}

function hideOverlay(){ document.getElementById("uploadOverlay").style.display="none"; }

window.onload = function(){
  try {
      loadBuiltin();
      hideOverlay();
      var sel=document.getElementById("selName"), i, o;
      sel.innerHTML="";
      N.forEach(function(n) {
          o=document.createElement("option"); o.value=n; o.text=n; sel.appendChild(o);
      });
      for(i=0; i<N.length; i++){ if(N[i].indexOf("ABHISHEK")>=0){ sel.value=N[i]; break; } }
      onNameChange();
  } catch(e) {
      console.error(e);
      document.getElementById("uploadStatus").textContent = "Startup Error: " + e.message;
      document.getElementById("uploadStatus").style.display = "block";
  }
};
</script>
