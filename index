function loadBuiltin(){
  D = EMB.dates; 
  N = EMB.names;
  E1 = new Set(EMB.desk1eligible);
  EA = new Set(EMB.deskAny33eligible);
  BAPM = new Set(EMB.apmNames);
  BSC = new Set(EMB.scNames);
  BG = new Set(EMB.gNames);
  RAW_SCHEDULE = {};
  N.forEach(function(n) {
      var rawArr = EMB.schedule[n];
      if (!rawArr) rawArr = new Array(D.length).fill(null);
      RAW_SCHEDULE[n] = rawArr.map(function(s) { return (s && s !== "L") ? s : null; });
  });
  CHANGE_LOG = [];
  populateSwapForm();
  renderLog();
}

function SL(c){return c?c[0]:null;}
function is33(c){return !!(c&&/^[A-C]33/.test(c));}

function checkEligibility(person, code) {
  if (!code || code === "OFF") return {ok: true, why: ""};
  var base = code.charAt(0);
  if (base === 'G' || code.indexOf("-SC") >= 0 || code.indexOf("ASC") >= 0 || code.indexOf("BSC") >= 0 || code.indexOf("-PM") >= 0) {
      return {ok: false, why: "G/SC/PM shift cannot be swapped"};
  }
  if (FEM.has(person) && base !== 'A') {
      return {ok: false, why: "Female staff restricted to A-Shift"};
  }
  if (person === "PRAGNYA" && !is33(code)) {
      return {ok: false, why: "PRAGNYA can only sit on 33kV desk"};
  }
  if (code.indexOf("33-1") >= 0 && !E1.has(person)) {
      return {ok: false, why: "Lacks 33-1 Desk certification"};
  }
  if (is33(code) && !EA.has(person)) {
      return {ok: false, why: "Lacks 33kV certification"};
  }
  return {ok: true, why: ""};
}

function checkSequence(person, testShiftCode, dayIdx) {
  var prevShift = RAW_SCHEDULE[person][dayIdx - 1];
  var nextShift = RAW_SCHEDULE[person][dayIdx + 1];
  var tPrev = prevShift ? prevShift.charAt(0) : '';
  var tNext = nextShift ? nextShift.charAt(0) : '';
  var tTest = testShiftCode ? testShiftCode.charAt(0) : '';

  if (tPrev === 'C' && (tTest === 'A' || tTest === 'B')) {
      return "Cannot do " + tTest + " immediately after C";
  }
  if (tTest === 'C' && (tNext === 'A' || tNext === 'B')) {
      return "Cannot do C immediately before " + tNext;
  }
  return null;
}

function bCls(c){
  if(!c || c==="OFF") return "boff";
  var l = c.charAt(0);
  if(l==="A") return "bA";
  if(l==="B") return "bB";
  if(l==="C") return "bC";
  return "bd";
}

function bdg(c){
  if(!c || c==="OFF") return "<span class=\"badge boff\">OFF</span>";
  return "<span class=\"badge "+bCls(c)+"\">"+c+"</span>";
}

function doShift(me, dayIdx, desired) {
  var myShift = RAW_SCHEDULE[me][dayIdx];
  if (!myShift) return {error: "You are OFF on this day. Use 'Want to WORK' mode."};
  var results = { direct: [], bridged: [], deskSwap: [], blocked: [] };

  N.forEach(function(partner) {
      if (partner === me) return;
      var theirShift = RAW_SCHEDULE[partner][dayIdx];
      if (!theirShift) return; 
      if (['G'].indexOf(theirShift.charAt(0)) >= 0 || theirShift.indexOf('SC') >= 0 || theirShift.indexOf('PM') >= 0) {
          results.blocked.push({partner: partner, theirShift: theirShift, reason: "SC/APM/G excluded"});
          return;
      }
      if (desired && desired !== 'ANY' && theirShift.charAt(0) !== desired) return;

      var meErr = checkSequence(me, theirShift, dayIdx);
      var pErr = checkSequence(partner, myShift, dayIdx);
      var meElig = checkEligibility(me, theirShift);
      var pElig = checkEligibility(partner, myShift);

      // C-Shift Compensation Logic for Direct Swaps
      var cCompDays = [];
      if (myShift.charAt(0) === 'C' && theirShift.charAt(0) !== 'C') {
          D.forEach(function(dObj, idx) {
              if (idx === dayIdx || idx === 0) return;
              var pShiftOther = RAW_SCHEDULE[partner][idx];
              var mShiftOther = RAW_SCHEDULE[me][idx] || 'OFF';
              if (pShiftOther && pShiftOther.charAt(0) === 'C') {
                  if (!checkSequence(me, pShiftOther, idx) && !checkSequence(partner, mShiftOther, idx) &&
                      checkEligibility(me, pShiftOther).ok && checkEligibility(partner, mShiftOther).ok) {
                      cCompDays.push({ date: dObj.label, myNewShift: pShiftOther, theirNewShift: mShiftOther });
                  }
              }
          });
      }

      if (!meErr && !pErr && meElig.ok && pElig.ok) {
          results.direct.push({ partner: partner, theirShift: theirShift, cCompDays: cCompDays });
      }
      else if (!meErr && !pErr && pElig.ok && !meElig.ok && is33(theirShift)) {
          var bridges = [];
          N.forEach(function(bridge) {
              if (bridge === me || bridge === partner) return;
              var bShift = RAW_SCHEDULE[bridge][dayIdx];
              if (!bShift || is33(bShift) || bShift.charAt(0) !== theirShift.charAt(0)) return;

              if (!checkSequence(bridge, theirShift, dayIdx) && checkEligibility(bridge, theirShift).ok &&
                  !checkSequence(me, bShift, dayIdx) && checkEligibility(me, bShift).ok) {
                  bridges.push({ name: bridge, shift: bShift });
              }
          });
          if (bridges.length > 0) {
              results.bridged.push({ partner: partner, theirShift: theirShift, bridges: bridges, cCompDays: cCompDays });
          } else {
              results.blocked.push({ partner: partner, theirShift: theirShift, reason: "Needs 33kV bridge, but no 11kV mediators available." });
          }
      }
      else if (myShift.charAt(0) === theirShift.charAt(0) && is33(theirShift) && !is33(myShift)) {
          if (checkEligibility(me, theirShift).ok && checkEligibility(partner, myShift).ok) {
              results.deskSwap.push({ partner: partner, theirShift: theirShift, cCompDays: cCompDays });
          }
      }
      else {
          var reasons = [meErr, pErr, meElig.why, pElig.why].filter(Boolean);
          results.blocked.push({ partner: partner, theirShift: theirShift, reason: reasons.join('; ') });
      }
  });
  return results;
}

function doOffWant(me, dayIdx, desired) {
  var myShift = RAW_SCHEDULE[me][dayIdx];
  if (!myShift) return {error: "You are already OFF. Use 'Want to WORK' mode."};
  var results = { direct: [], bridged: [], blocked: [] };

  N.forEach(function(partner) {
      if (partner === me) return;
      var theirShift = RAW_SCHEDULE[partner][dayIdx];
      if (theirShift) return; 

      var pErr = checkSequence(partner, myShift, dayIdx);
      var pElig = checkEligibility(partner, myShift);
      var pCanTakeDirect = !pErr && pElig.ok;
      var pNeedsBridge = !pErr && !pElig.ok && is33(myShift);

      if (!pCanTakeDirect && !pNeedsBridge) {
          results.blocked.push({ partner: partner, theirShift: 'OFF', reason: pErr || pElig.why });
          return;
      }

      var bridges = [];
      if (pNeedsBridge) {
          N.forEach(function(bridge) {
              if (bridge === me || bridge === partner) return;
              var bShift = RAW_SCHEDULE[bridge][dayIdx];
              if (!bShift || is33(bShift) || bShift.charAt(0) !== myShift.charAt(0)) return;

              if (!checkSequence(bridge, myShift, dayIdx) && checkEligibility(bridge, myShift).ok &&
                  !checkSequence(partner, bShift, dayIdx) && checkEligibility(partner, bShift).ok) {
                  bridges.push({ name: bridge, shift: bShift });
              }
          });
          if (bridges.length === 0) {
              results.blocked.push({ partner: partner, theirShift: 'OFF', reason: "Needs 33kV bridge, but no 11kV mediators available." });
              return;
          }
      }

      var giveDays = [];
      D.forEach(function(dObj, idx) {
          if (idx === dayIdx || idx === 0) return;
          if (RAW_SCHEDULE[me][idx]) return; 
          var pShiftOnOd = RAW_SCHEDULE[partner][idx];
          if (!pShiftOnOd) return; 
          if (desired && desired !== 'ANY' && pShiftOnOd.charAt(0) !== desired) return;

          if (!checkSequence(me, pShiftOnOd, idx) && checkEligibility(me, pShiftOnOd).ok) {
              giveDays.push({ 
                  date: dObj.label, 
                  myNewShift: pShiftOnOd,
                  theirNewShift: 'OFF',
                  isCComp: pShiftOnOd === 'C3' && myShift.charAt(0) === 'C'
              });
          }
      });

      if (giveDays.length > 0) {
          giveDays.sort(function(a, b) { return (b.isCComp ? 1:0) - (a.isCComp ? 1:0); });
          if (pCanTakeDirect) {
              results.direct.push({ partner: partner, theirShift: 'OFF', giveDays: giveDays });
          } else {
              results.bridged.push({ partner: partner, theirShift: 'OFF', bridges: bridges, giveDays: giveDays });
          }
      } else {
          results.blocked.push({ partner: partner, theirShift: 'OFF', reason: "Partner can cover, but you have no valid give-days." });
      }
  });
  return results;
}

function doOffWork(me, dayIdx, desired) {
  var myShift = RAW_SCHEDULE[me][dayIdx];
  if (myShift) return {error: "You are working (" + myShift + "). Use 'Want OFF' mode."};
  var results = { direct: [], bridged: [], blocked: [] };

  N.forEach(function(partner) {
      if (partner === me) return;
      var theirShift = RAW_SCHEDULE[partner][dayIdx];
      if (!theirShift || ['G'].indexOf(theirShift.charAt(0)) >= 0 || theirShift.indexOf('SC') >= 0 || theirShift.indexOf('PM') >= 0) return;
      if (desired && desired !== 'ANY' && theirShift.charAt(0) !== desired) return;

      var meErr = checkSequence(me, theirShift, dayIdx);
      var meElig = checkEligibility(me, theirShift);
      var meCanTakeDirect = !meErr && meElig.ok;
      var meNeedsBridge = !meErr && !meElig.ok && is33(theirShift);

      if (!meCanTakeDirect && !meNeedsBridge) {
          results.blocked.push({ partner: partner, theirShift: theirShift, reason: meErr || meElig.why });
          return;
      }

      var bridges = [];
      if (meNeedsBridge) {
          N.forEach(function(bridge) {
              if (bridge === me || bridge === partner) return;
              var bShift = RAW_SCHEDULE[bridge][dayIdx];
              if (!bShift || is33(bShift) || bShift.charAt(0) !== theirShift.charAt(0)) return;

              if (!checkSequence(bridge, theirShift, dayIdx) && checkEligibility(bridge, theirShift).ok &&
                  !checkSequence(me, bShift, dayIdx) && checkEligibility(me, bShift).ok) {
                  bridges.push({ name: bridge, shift: bShift });
              }
          });
          if (bridges.length === 0) {
              results.blocked.push({ partner: partner, theirShift: theirShift, reason: "Needs 33kV bridge, but no 11kV mediators available." });
              return;
          }
      }

      var returnDays = [];
      D.forEach(function(dObj, idx) {
          if (idx === dayIdx || idx === 0) return;
          var myOrigShift = RAW_SCHEDULE[me][idx];
          if (!myOrigShift) return; 
          var pShiftOnOd = RAW_SCHEDULE[partner][idx];
          if (pShiftOnOd) return; 

          if (!checkSequence(partner, myOrigShift, idx) && checkEligibility(partner, myOrigShift).ok) {
              returnDays.push({ 
                  date: dObj.label, 
                  myNewShift: 'OFF',
                  theirNewShift: myOrigShift,
                  isCComp: false 
              });
          }
      });

      if (returnDays.length > 0) {
          if (meCanTakeDirect) {
              results.direct.push({ partner: partner, theirShift: theirShift, giveDays: returnDays });
          } else {
              results.bridged.push({ partner: partner, theirShift: theirShift, bridges: bridges, giveDays: returnDays });
          }
      } else {
          results.blocked.push({ partner: partner, theirShift: theirShift, reason: "You can cover them, but they cannot return any of your off days." });
      }
  });
  return results;
}

